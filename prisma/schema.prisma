generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String
  users     User[]

  @@map("ROLE")
}

model User {
  user_id               Int                  @id @default(autoincrement())
  role_id               Int
  full_name             String
  username              String               @unique
  password_hash         String?
  clerk_id              String?              @unique

  created_creditNotes           CreditNote[]         @relation("CreditNoteCreatedBy")
  deleted_creditNotes CreditNote[] @relation("CreditNoteDeletedBy")
  created_goodsIssueNotes       GoodsIssueNote[]  @relation("GINCreatedBy")
  deleted_goodsIssueNotes GoodsIssueNote[]        @relation("GINDeletedBy")
  created_goodsReceivingNotes GoodsReceivingNote[] @relation("GoodsReceivingNoteCreatedBy")
  deleted_goodsReceivingNotes GoodsReceivingNote[] @relation("GoodsReceivingNoteDeletedBy")
  created_goodsReturnNotes      GoodsReturnNote[]    @relation("GoodsReturnNoteCreatedBy")
  deleted_goodsReturnNotes GoodsReturnNote[] @relation("GoodsReturnNoteDeletedBy")
  created_invoices      Invoice[]            @relation("InvoiceCreatedBy")
  deleted_invoices      Invoice[]            @relation("InvoiceDeletedBy")
  created_receipts              Receipt[]            @relation("ReceiptCreatedBy")
  deleted_receipts Receipt[] @relation("ReceiptDeletedBy")
  created_salesReturnNotes SalesReturnNote[] @relation("SalesReturnNoteCreatedBy")
  deleted_salesReturnNotes SalesReturnNote[] @relation("SalesReturnNoteDeletedBy")
  stock_movements       StockMovement[]      @relation("StockMovementCreatedBy")
  role                  Role                 @relation(fields: [role_id], references: [role_id])

  @@map("USER")
}

model SalesRep {
  rep_id      Int          @id @default(autoincrement())
  full_name   String
  phone       String
  commissions Commission[]
  customers   Customer[]
  invoices    Invoice[]

  @@map("SALES_REP")
}

model Customer {
  customer_id       Int               @id @default(autoincrement())
  assigned_rep_id   Int
  name              String
  address           String?
  phone             String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @default(now()) @updatedAt
  assigned_rep      SalesRep          @relation(fields: [assigned_rep_id], references: [rep_id])
  goods_issue_notes GoodsIssueNote[]
  goodsReturnNotes  GoodsReturnNote[]
  invoices          Invoice[]
  reminders         Reminder[]
  salesReturnNotes  SalesReturnNote[]

  @@index([assigned_rep_id])
  @@map("CUSTOMER")
}

model Invoice {
  invoice_id         Int                 @id @default(autoincrement())
  invoice_number     String              @unique
  customer_id        Int
  rep_id             Int
  location_id        Int
  invoice_date       DateTime

  total_amount    Decimal             @db.Decimal(10, 2) //initial total
  paid_amount     Decimal @default(0) @db.Decimal(10, 2) //from receipts
  credited_amount Decimal @default(0) @db.Decimal(10, 2) //from returns
  balance_amount  Decimal @default(0) @db.Decimal(10, 2) //final

  payment_status     InvoiceStatus       @default(UNPAID)
  gin_status         GINStatus           @default(PENDING)
  
  created_by         Int
  created_at         DateTime            @default(now())
  is_active          Boolean             @default(true)
  updated_at         DateTime            @default(now()) @updatedAt
  deleted_by         Int?
  notes              String?

  creditNotes        CreditNote[]
  goods_issue_notes  GoodsIssueNote[]
  creator            User                @relation("InvoiceCreatedBy", fields: [created_by], references: [user_id])
  deleter            User?               @relation("InvoiceDeletedBy", fields: [deleted_by], references: [user_id])
  customer           Customer            @relation(fields: [customer_id], references: [customer_id])
  location           InventoryLocation   @relation(fields: [location_id], references: [location_id])
  rep                SalesRep            @relation(fields: [rep_id], references: [rep_id])
  invoice_lines      InvoiceLine[]
  invoiceSettlements InvoiceSettlement[]
  receipts           Receipt[]
  salesReturnNotes   SalesReturnNote[]

  @@map("INVOICE")
}

model InvoiceLine {
  line_id        Int               @id @default(autoincrement())
  invoice_id     Int
  product_id     Int

  quantity       Int
  free_quantity  Int               @default(0)
  issued_qty     Int               @default(0)
  returned_qty   Int               @default(0)
  balance_qty    Int               @default(0)

  unit_price     Decimal           @db.Decimal(10, 2)
  discount       Decimal           @default(0) @db.Decimal(10, 2)
  line_total     Decimal           @db.Decimal(10, 2)
  net_line_total Decimal           @db.Decimal(10, 2)

  promotion_type LinePromotionType @default(NONE)
  invoice        Invoice           @relation(fields: [invoice_id], references: [invoice_id])
  product        Product           @relation(fields: [product_id], references: [product_id])

  @@map("INVOICE_LINE")
}

model SalesReturnNote {
  return_id        Int                   @id @default(autoincrement())
  return_number    String                @unique
  return_date      DateTime
  customer_id      Int
  location_id      Int
  invoice_id       Int
  total_amount     Decimal               @db.Decimal(10, 2)
  notes            String?
  created_by       Int
  created_at       DateTime              @default(now())
  updated_at       DateTime              @default(now()) @updatedAt
  is_active        Boolean               @default(true)
  deleted_by       Int?
  
  deleter          User?                 @relation("SalesReturnNoteDeletedBy", fields: [deleted_by], references: [user_id])
  creditNotes      CreditNote[]
  goodsReturnNotes GoodsReturnNote[]
  creator          User                  @relation("SalesReturnNoteCreatedBy", fields: [created_by], references: [user_id])
  customer         Customer              @relation(fields: [customer_id], references: [customer_id])
  invoice          Invoice               @relation(fields: [invoice_id], references: [invoice_id])
  location         InventoryLocation     @relation(fields: [location_id], references: [location_id])
  lines            SalesReturnNoteLine[]

  @@index([customer_id])
  @@index([location_id])
  @@map("SALES_RETURN_NOTE")
}

model SalesReturnNoteLine {
  return_line_id    Int             @id @default(autoincrement())
  return_id         Int
  product_id        Int
  quantity          Int
  condition         String
  reason_for_return String
  line_total        Decimal         @db.Decimal(10, 2)
  product           Product         @relation(fields: [product_id], references: [product_id])
  sales_return_note SalesReturnNote @relation(fields: [return_id], references: [return_id])

  @@index([return_id])
  @@index([product_id])
  @@map("SALES_RETURN_NOTE_LINE")
}

model GoodsIssueNote {
  gin_id      Int                  @id @default(autoincrement())
  invoice_id  Int
  gin_number  String               @unique
  gin_date    DateTime
  customer_id Int
  location_id Int

  prepared_by String
  received_by String

  created_at  DateTime             @default(now())
  created_by  Int
  is_active   Boolean              @default(true)
  notes       String?
  updated_at  DateTime             @default(now()) @updatedAt
  deleted_by  Int?

  deleter     User?                 @relation("GINDeletedBy", fields: [deleted_by], references: [user_id])
  creator     User                 @relation("GINCreatedBy", fields: [created_by], references: [user_id])
  customer    Customer             @relation(fields: [customer_id], references: [customer_id])
  invoice     Invoice              @relation(fields: [invoice_id], references: [invoice_id])
  location    InventoryLocation    @relation(fields: [location_id], references: [location_id])
  lines       GoodsIssueNoteLine[]

  @@index([invoice_id])
  @@index([customer_id])
  @@index([location_id])
  @@map("GOODS_ISSUE_NOTE")
}

model GoodsIssueNoteLine {
  gin_line_id      Int            @id @default(autoincrement())
  gin_id           Int
  product_id       Int
  quantity         Int
  goods_issue_note GoodsIssueNote @relation(fields: [gin_id], references: [gin_id])
  product          Product        @relation(fields: [product_id], references: [product_id])

  @@index([gin_id])
  @@index([product_id])
  @@map("GOODS_ISSUE_NOTE_LINE")
}

model GoodsReturnNote {
  return_id         Int                   @id @default(autoincrement())
  return_number     String
  return_date       DateTime
  customer_id       Int
  location_id       Int
  srn_id            Int
  notes             String?
  created_by        Int
  created_at        DateTime              @default(now())
  updated_at        DateTime              @default(now()) @updatedAt
  is_active         Boolean               @default(true)
  deleted_by        Int?
  deleter          User?                 @relation("GoodsReturnNoteDeletedBy", fields: [deleted_by], references: [user_id])
  creator           User                  @relation("GoodsReturnNoteCreatedBy", fields: [created_by], references: [user_id])
  customer          Customer              @relation(fields: [customer_id], references: [customer_id])
  location          InventoryLocation     @relation(fields: [location_id], references: [location_id])
  sales_return_note SalesReturnNote       @relation(fields: [srn_id], references: [return_id])
  lines             GoodsReturnNoteLine[]

  @@index([customer_id])
  @@index([location_id])
  @@map("GOODS_RETURN_NOTE")
}

model GoodsReturnNoteLine {
  return_line_id    Int             @id @default(autoincrement())
  return_id         Int
  product_id        Int
  quantity          Int
  product           Product         @relation(fields: [product_id], references: [product_id])
  goods_return_note GoodsReturnNote @relation(fields: [return_id], references: [return_id])

  @@index([return_id])
  @@index([product_id])
  @@map("GOODS_RETURN_NOTE_LINE")
}

model GoodsReceivingNote {
  grn_id       Int                      @id @default(autoincrement())
  grn_number   String                   @unique
  grn_date     DateTime
  entry_type   StockEntryType
  location_id  Int
  reference_no String?
  notes        String?
  created_by   Int
  created_at   DateTime                 @default(now())
  is_active    Boolean                  @default(true)
  updated_at   DateTime                 @default(now()) @updatedAt
  deleted_by   Int?
  deleter      User?                     @relation("GoodsReceivingNoteDeletedBy", fields: [deleted_by], references: [user_id])
  creator      User                     @relation("GoodsReceivingNoteCreatedBy", fields: [created_by], references: [user_id])
  location     InventoryLocation        @relation(fields: [location_id], references: [location_id])
  lines        GoodsReceivingNoteLine[]

  @@index([location_id])
  @@index([created_by])
  @@map("GOODS_RECEIVING_NOTE")
}

model GoodsReceivingNoteLine {
  grn_line_id          Int                @id @default(autoincrement())
  grn_id               Int
  product_id           Int
  quantity             Int
  goods_receiving_note GoodsReceivingNote @relation(fields: [grn_id], references: [grn_id])
  product              Product            @relation(fields: [product_id], references: [product_id])

  @@index([grn_id])
  @@index([product_id])
  @@map("GOODS_RECEIVING_NOTE_LINE")
}

model Receipt {
  receipt_id         Int                 @id @default(autoincrement())
  invoice_id         Int
  receipt_date       DateTime

  payment_method     PaymentMethod
  cheque_no          String?
  cheque_date        DateTime?
  bank_name          String?

  amount             Decimal             @db.Decimal(10, 2)
  created_at         DateTime            @default(now())
  created_by         Int
  is_active          Boolean             @default(true)
  notes              String?
  updated_at         DateTime            @default(now()) @updatedAt
  deleted_by         Int?

  deleter            User?               @relation("ReceiptDeletedBy", fields: [deleted_by], references: [user_id])
  invoiceSettlements InvoiceSettlement[]
  creator            User                @relation("ReceiptCreatedBy", fields: [created_by], references: [user_id])
  invoice            Invoice             @relation(fields: [invoice_id], references: [invoice_id])

  @@map("RECEIPT")
}

model CreditNote {
  credit_note_id    Int             @id @default(autoincrement())
  srn_id            Int
  invoice_id        Int
  amount            Decimal         @db.Decimal(10, 2)
  notes             String?
  created_by        Int
  created_at        DateTime        @default(now())
  updated_at        DateTime        @default(now()) @updatedAt
  is_active         Boolean         @default(true)
  deleted_by        Int?
  deleter          User?           @relation("CreditNoteDeletedBy", fields: [deleted_by], references: [user_id])
  creator           User            @relation("CreditNoteCreatedBy", fields: [created_by], references: [user_id])
  invoice           Invoice         @relation(fields: [invoice_id], references: [invoice_id])
  sales_return_note SalesReturnNote @relation(fields: [srn_id], references: [return_id])

  @@map("CREDIT_NOTE")
  invoiceSettlements InvoiceSettlement[]
}

model InvoiceSettlement {
  settlement_id Int          @id @default(autoincrement())
  invoice_id    Int
  receipt_id    Int?
  credit_note_id Int?
  amount        Decimal      @db.Decimal(10, 2)
  settlement_type SettlementType
  settled_date  DateTime
  invoice       Invoice      @relation(fields: [invoice_id], references: [invoice_id])
  receipt       Receipt?     @relation(fields: [receipt_id], references: [receipt_id])
  creditNote    CreditNote?  @relation(fields: [credit_note_id], references: [credit_note_id])
  commissions   Commission[] @relation("CommissionToInvoiceSettlement")

  @@index([invoice_id])
  @@map("INVOICE_SETTLEMENT")
}

model Commission {
  commission_id      Int                 @id @default(autoincrement())
  rep_id             Int
  commission_rate    Decimal             @db.Decimal(5, 4)
  commission_amount  Decimal             @db.Decimal(10, 2)
  days_to_pay        Int
  status             CommissionStatus    @default(PENDING)
  created_at         DateTime            @default(now())
  settlement_id      Int
  updated_at         DateTime            @default(now()) @updatedAt
  rep                SalesRep            @relation(fields: [rep_id], references: [rep_id])
  invoiceSettlements InvoiceSettlement[] @relation("CommissionToInvoiceSettlement")

  @@map("COMMISSION")
}

model Reminder {
  reminder_id   Int            @id @default(autoincrement())
  customer_id   Int
  triggered_by  Int
  reminder_date DateTime
  message       String
  status        ReminderStatus
  customer      Customer       @relation(fields: [customer_id], references: [customer_id])

  @@map("REMINDER")
}

model Category {
  category_id Int       @id @default(autoincrement())
  name        String
  tag         String    @unique
  products    Product[]

  @@map("CATEGORY")
}

model Product {
  product_id                 Int                      @id @default(autoincrement())
  category_id                Int
  product_code               String                   @unique
  product_name               String
  pack_size                  String
  selling_price              Decimal                  @db.Decimal(10, 2)
  reorder_threshold          Int                      @default(0)
  goods_issue_note_lines     GoodsIssueNoteLine[]
  goods_receiving_note_lines GoodsReceivingNoteLine[]
  goodsReturnNoteLines       GoodsReturnNoteLine[]
  invoice_lines              InvoiceLine[]
  category                   Category                 @relation(fields: [category_id], references: [category_id])
  salesReturnNoteLines       SalesReturnNoteLine[]
  stocks                     Stock[]
  stock_movements            StockMovement[]          @relation("StockMovementProduct")

  @@map("PRODUCT")
}

model InventoryLocation {
  location_id           Int                  @id @default(autoincrement())
  code                  String               @unique
  name                  String
  address               String?
  status                LocationStatus       @default(ACTIVE)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @default(now())
  goods_issue_notes     GoodsIssueNote[]
  goods_receiving_notes GoodsReceivingNote[]
  goodsReturnNotes      GoodsReturnNote[]
  invoices              Invoice[]
  salesReturnNotes      SalesReturnNote[]
  stocks                Stock[]

  @@index([status])
  @@map("INVENTORY_LOCATION")
}

model Stock {
  stock_id         Int               @id @default(autoincrement())
  product_id       Int
  location_id      Int
  quantity_on_hand Int
  location         InventoryLocation @relation(fields: [location_id], references: [location_id])
  product          Product           @relation(fields: [product_id], references: [product_id])
  stock_movements  StockMovement[]

  @@unique([product_id, location_id])
  @@index([location_id])
  @@index([product_id])
  @@map("STOCK")
}

model StockMovement {
  movement_id   Int          @id @default(autoincrement())
  stock_id      Int
  created_by    Int
  movement_type MovementType
  quantity      Int
  movement_date DateTime
  notes         String?
  product_id    Int
  creator       User         @relation("StockMovementCreatedBy", fields: [created_by], references: [user_id])
  product       Product      @relation("StockMovementProduct", fields: [product_id], references: [product_id])
  stock         Stock        @relation(fields: [stock_id], references: [stock_id])

  @@index([stock_id, movement_type])
  @@map("STOCK_MOVEMENT")
}

enum InvoiceStatus {
  PAID
  PARTIAL
  UNPAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
}

enum MovementType {
  ISSUE
  RETURN
  PURCHASE
  ADJUSTMENT
  NON_SALEABLE
}

enum StockEntryType {
  LOCAL_PURCHASE
  FOREIGN_IMPORT
}

enum ReminderStatus {
  PENDING
  COMPLETED
}

enum GINStatus {
  PENDING
  ISSUED
  PARTIAL
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum LinePromotionType {
  NONE
  DISCOUNT
  FREE_QTY
}

enum SettlementType {
  RECEIPT
  CREDIT_NOTE
  ADJUSTMENT
}