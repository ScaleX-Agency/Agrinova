# === DATABASE CONNECTIONS ===

# Recommended: Transaction Pooler connection string (usually Port 6543)
# Used by the application runtime for optimal performance in serverless/edge environments.
# Include ?pgbouncer=true if using Supavisor in transaction mode.
DATABASE_URL="postgresql://postgres.[PROJ_ID]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Required: Direct connection string (Port 5432)
# Used by Prisma CLI for migrations, introspection, and schema verification.
DIRECT_URL="postgresql://postgres.[PROJ_ID]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# === APPLICATION SETTINGS ===

# The environment mode (development, production, test)
NODE_ENV="development"
